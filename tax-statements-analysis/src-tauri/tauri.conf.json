{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tax-statements-analysis",
  "version": "0.1.0",
  "identifier": "com.har.tax-statements-analysis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tax-statements-analysis",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RTc4NEI2NTZEMDFFQzkKUldUSkh0Qld0b1RuZVhDMGROUTEvcHRWRjVVVm5GUDhNQTJEV05TTWRERkQ4SHplSkszbXpHVmwK",
      "endpoints": [
        "https://github.com/Muhammad-Arham-MERN/taxing-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
