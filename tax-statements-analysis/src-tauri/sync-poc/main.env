# --- Oracle Object Storage (Amazon S3 Compatibility API) ---------------------
# Path-style base endpoint (no bucket in the host):
#   https://<namespace>.compat.objectstorage.<region>.oci.customer-oci.com
OCI_S3_ENDPOINT=https://bmkc0pvjvwjx.compat.objectstorage.ap-mumbai-1.oraclecloud.com
# OCI region identifier, e.g. us-ashburn-1, uk-london-1, ap-mumbai-1.
# If your client cannot set a region, use us-east-1 (home region only).
OCI_S3_REGION=ap-mumbai-1
# An existing bucket; this POC reads/writes/deletes objects but never creates buckets.
OCI_S3_BUCKET=bucket-20261012-2106
